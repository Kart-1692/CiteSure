# Copy to .env and fill in ONE of the blocks below. Any OpenAI-compatible endpoint works.
# Model ids change often: after setting the URL and key, run  python -m egc.cli models
# and copy an id from that list into EGC_LLM_MODEL.

# --- Groq (free tier, fast) --------------------------------------------------
EGC_LLM_BASE_URL=https://api.groq.com/openai/v1
EGC_LLM_API_KEY=gsk_your_key_here
EGC_LLM_MODEL=llama-3.3-70b-versatile
EGC_LLM_MIN_INTERVAL=2.5        # seconds between calls, keeps a free tier under its rate limit

# --- Google Gemini (OpenAI-compatible endpoint) ------------------------------
# EGC_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# EGC_LLM_API_KEY=your_gemini_key
# EGC_LLM_MODEL=<id from `python -m egc.cli models`>

# --- Ollama (fully local, no key) --------------------------------------------
# EGC_LLM_BASE_URL=http://localhost:11434/v1
# EGC_LLM_API_KEY=not-needed
# EGC_LLM_MODEL=<the model you pulled with `ollama pull`>

# --- optional overrides (defaults shown) -------------------------------------
# EGC_STORE_DIR=store
# EGC_EMBEDDER=sentence-transformers/all-MiniLM-L6-v2
# EGC_CHUNK_WORDS=180
# EGC_CHUNK_OVERLAP=40
# EGC_TOP_K_ASK=6
# EGC_TOP_K_EXPLAIN=8
# EGC_TOP_K_SUMMARIZE=10
# EGC_VERIFIER=llm              # llm | nli
# EGC_STRICT_QUOTE=true
